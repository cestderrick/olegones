# Backend
ADMIN_PASSWORD=olegones2024
JWT_SECRET=change_this_to_a_long_random_string

# Backup GitHub Gist (optionnel mais recommandé sur Render sans disque)
# 1. Aller sur https://gist.github.com → New secret Gist → fichier "db.json" contenu "{}" → Create
# 2. Copier l'ID dans l'URL (ex: https://gist.github.com/user/CECI_EST_L_ID)
# 3. Créer un token sur https://github.com/settings/tokens → Gist scope uniquement
# GITHUB_GIST_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Google Search Console (optionnel — coller le code "google-site-verification")
# NEXT_PUBLIC_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxx

# Analytics Umami (optionnel)
# Décommentez et remplissez après avoir installé Umami
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.votre-domaine.fr/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
